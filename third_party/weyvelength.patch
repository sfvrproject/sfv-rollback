+// How a link's datagrams travel, from its selected ICE candidate pair.
+typedef enum WeyveLinkPath {
+	WEYVE_LINK_NONE = 0, // no link up
+	WEYVE_LINK_UNKNOWN = 1, // up, but ICE cannot say how
+	WEYVE_LINK_DIRECT = 2, // peer to peer (host or server-reflexive candidates)
+	WEYVE_LINK_RELAYED = 3, // through a TURN relay
+} WeyveLinkPath;
+WEYVE_API WeyveLinkPath weyve_peer_link_path(WeyveClient* client, uint32_t id);
+// The first TURN server the rooms server handed out ("turn.cloudflare.com"), or
+// null without one. Borrowed, valid until the next weyve_poll.
+WEYVE_API const char* weyve_turn_host(const WeyveClient* client);
+// Testing: links built from now on take only the peer's relay candidates, so
+// they connect through TURN or not at all.
+WEYVE_API void weyve_set_relay_only(WeyveClient* client, bool on);
+
 // --- cached room state ---
 // Getters below read the client's cache; nothing blocks or hits the network.
 
