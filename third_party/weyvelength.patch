+	// A selected candidate (an sdp "a=candidate:" line) through a TURN relay.
+	static bool IsRelayCandidate(const char* sdp)
+	{
+		return std::strstr(sdp, " typ relay") != nullptr;
+	}
+
+	int Client::PeerLinkPath(uint32_t id) const
+	{
+		auto it = _mesh->links.find(id);
+		if (it == _mesh->links.end() || !it->second.connected)
+			return 0; // WEYVE_LINK_NONE
+		char local[JUICE_MAX_CANDIDATE_SDP_STRING_LEN] = {};
+		char remote[JUICE_MAX_CANDIDATE_SDP_STRING_LEN] = {};
+		if (juice_get_selected_candidates(it->second.agent, local, sizeof(local), remote, sizeof(remote)) != JUICE_ERR_SUCCESS)
+			return 1; // WEYVE_LINK_UNKNOWN: up, but juice cannot say how
+		// either end allocating on a relay means every datagram crosses it
+		return IsRelayCandidate(local) || IsRelayCandidate(remote) ? 3 : 2; // WEYVE_LINK_RELAYED : WEYVE_LINK_DIRECT
+	}
+
+	const std::string* Client::TurnHost() const
+	{
+		return _ice.turn.empty() ? nullptr : &_ice.turn.front().host;
+	}
+
+	void Client::SetRelayOnly(bool on)
+	{
+		_relay_only = on;
+	}
+
+	// Relay-only testing: a remote description without its non-relay candidates.
+	static std::string KeepRelayCandidates(const std::string& sdp)
+	{
+		std::string out;
+		size_t start = 0;
+		while (start < sdp.size()) {
+			size_t end = sdp.find('\n', start);
+			if (end == std::string::npos)
+				end = sdp.size();
+			const std::string line = sdp.substr(start, end - start);
+			if (line.rfind("a=candidate:", 0) != 0 || IsRelayCandidate(line.c_str()))
+				out += line + "\n";
+			start = end + 1;
+		}
+		return out;
+	}
+
 	PeerLink* Client::FindLink(uint32_t id)
 	{
 		auto it = _mesh->links.find(id);
